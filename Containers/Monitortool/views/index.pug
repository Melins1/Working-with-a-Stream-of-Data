html
  head
    title MonitorTool Dashnoard
    //- meta(http-equiv="refresh", content="5")
    script(src="https://cdn.jsdelivr.net/npm/chart.js")
    link(href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet")
    style.
        body {
            font-family: 'Roboto', sans-serif;
        }
        h1.title {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 50px;
        } 
        div.countCollection {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
        }
        div.count {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            margin: 10px 50px;
        }
        #amount {
            margin-top: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #statusTitle {
            margin-top: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        div.showUpdates {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        div.chunkprocesstime {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-top: 50px
        }
        div.processtimegraphs {
            display: flex;
            flex-direction: column;
            gap:80px
        }
        div.avgdata  {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-top: 50px
        }
        

  body

    h1.title MonitorTool
    div.amount
        h2#amount Document amount in specific collections
        div.countCollection
            div.count 
                h3 Files
                p #{countFiles}
            div.count 
                h3 Chunks
                p #{countChunks}
            div.count 
                h3 Candidates
                p #{countCandidates}
            div.count 
                h3 Clones
                p #{countClones}
    div.statusUpdates
        h2#statusTitle Status Updates 
        div.showUpdates
            each update in statusUpdates
                div.update 
                    p
                        strong=update.timestamp
                        |  - #{update.message}

    div.avgdata 
        h2 Average Data 
        p Average number of chunks per file: #{avgChunksPerFile} 
        p Average Clone size: #{avgCloneSize}

    div.chunkprocesstime
        h2 Processtime data
        div.processtimegraphs
            canvas#processChart(width="500" height="400")
            canvas#processChartCandidate(width="500" height="400")
            canvas#processChartClone(width="500" height="400")
    
    script. 
        const processDataChunk = !{JSON.stringify(processData.chunks)}
        const labelsChunk = processDataChunk.map(item => item.amount);
        const timesChunk = processDataChunk.map(item => item.time);
        const timestampChunk = processDataChunk.map(item => item.timestamp);

        const processDataClone = !{JSON.stringify(processData.clones)}
        const labelsClone = processDataClone.map(item => item.amount);
        const timesClone = processDataClone.map(item => item.time);
        const timestampClone = processDataClone.map(item => item.timestamp);


        const processDataCandidate = !{JSON.stringify(processData.candidates)}
        const labelsCandidate = processDataCandidate.map(item => item.amount);
        const timesCandidate = processDataCandidate.map(item => item.time);
        const timestampCandidate = processDataCandidate.map(item => item.timestamp);


        new Chart(document.getElementById('processChart'), {
            type: 'line',
            data: {
                labels: timestampChunk,
                datasets: [{
                    label: 'Processtime per chunk creation',
                    data: labelsChunk,
                    borderColor: 'blue',
                    backgroundColor: 'rgba(0,0,255,0.2)',
                    fill: true
                }]
            },
            options: {
                responsive: false, 
                scales: {
                    x: { title: { display: true, text: 'Time Unix' } },
                    y: { title: { display: true, text: 'Amount of Chunks' } }
                }
                }
        });

        new Chart(document.getElementById('processChartCandidate'), {
            type: 'line',
            data: {
                labels: timestampCandidate,
                datasets: [{
                    label: 'Processtime per candidate',
                    data: labelsCandidate,
                    borderColor: 'red',
                    backgroundColor: 'rgba(255, 0, 0, 0.27)',
                    fill: true
                }]
            },
            options: {
                responsive: false, 
                scales: {
                    x: { title: { display: true, text: 'Time Unix' } },
                    y: { title: { display: true, text: 'Amount of Candidates' } }
                }
                }
        });

        new Chart(document.getElementById('processChartClone'), {
            type: 'line',
            data: {
                labels: timestampClone,
                datasets: [{
                    label: 'Processtime per clone creation',
                    data: labelsClone,
                    borderColor: 'green',
                    backgroundColor: 'rgba(0, 255, 0, 0.2)',
                    fill: true
                }]
            },
            options: {
                responsive: false, 
                scales: {
                    x: { title: { display: true, text: 'Time Unix' } },
                    y: { title: { display: true, text: 'Amount of Clones' } }
                }
                }
        });
